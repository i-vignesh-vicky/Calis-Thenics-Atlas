# ─────────────────────────────────────────────────────────────────────────────
# Atlas · Local Development Environment Configuration
#
# Copy this file to .env and fill in your local values.
# .env is gitignored and must never be committed.
#
# Required keys must be set before the app will start.
# Optional keys enable specific features; the app starts without them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Required. PostgreSQL connection string for the local development database.
# Start the database with: make db-up (see STORY-005C)
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas_dev

# ── JWT ───────────────────────────────────────────────────────────────────────
# Required. Secret used to sign and verify JWT access tokens.
# Use any random string locally. In production this must be a strong secret managed via secrets manager.
JWT_SECRET=change-me-local-only-do-not-use-in-production

# Required. Identifies the party that issued the token.
JWT_ISSUER=atlas-local

# Required. Identifies the intended audience for the token.
JWT_AUDIENCE=atlas-app

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
# Required. Sets the environment name. Must be Development for local dev.
ASPNETCORE_ENVIRONMENT=Development

# Required. URL(s) the backend listens on.
ASPNETCORE_URLS=http://localhost:5000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Required. Base URL the Flutter app uses for all API calls.
# Must match ASPNETCORE_URLS above, including the /api/v1 prefix.
API_BASE_URL=http://localhost:5000/api/v1

# ── Optional (future features) ────────────────────────────────────────────────
# The following keys are not required for Week 01–08 local development.
# They become required when the relevant epic is implemented.

# Push notifications (Week 09 — epic-09)
# FIREBASE_SERVER_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
