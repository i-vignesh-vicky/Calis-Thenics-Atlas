# ─────────────────────────────────────────────────────────────────────────────
# Atlas · Local Development Environment Configuration
#
# Copy this file to .env and source it before running the backend.
# .env is gitignored and must never be committed.
#
# This repo reads local configuration from .NET appsettings and environment
# variables. The values below match the defaults used by the local Docker
# PostgreSQL container and ASP.NET configuration.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Connection string used by the API in Development mode.
ConnectionStrings__AtlasDb="Host=localhost;Port=5432;Database=atlas;Username=atlas;Password=atlas_local"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Required values for app startup and token validation.
App__JwtSecret="change-me-local-only-do-not-use-in-production-32+"
App__JwtIssuer="atlas-local"
App__JwtAudience="atlas-app"

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT="Development"
ASPNETCORE_URLS="http://localhost:5028"

# ── Frontend ──────────────────────────────────────────────────────────────────
# Must match the API base URL you actually run locally.
API_BASE_URL="http://localhost:5028/api/v1"

# ── Optional (future features) ────────────────────────────────────────────────
# FIREBASE_SERVER_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
