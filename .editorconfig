root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,sln,props,targets}]
indent_style = space
indent_size = 4

[*.dart]
indent_style = space
indent_size = 2

[*.{json,yaml,yml,md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4
